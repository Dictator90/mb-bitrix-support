{
  "name": "mb4it/bitrix-support",
  "description": "Helper library for 1C-Bitrix: DI/Foundation, ORM storage, migrations, files, logging.",
  "type": "library",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "mb4it/bitrix-contracts": "@dev",
    "mb4it/container": "@dev",
    "mb4it/stringable": "@dev",
    "mb4it/collections": "@dev",
    "mb4it/conditionable": "@dev",
    "mb4it/filesystem": "@dev",
    "mb4it/logger": "@dev",
    "spatie/image": "^3.8",
    "ext-fileinfo": "*",
    "psr/log": "^1.0|^2.0|^3.0"
  },
  "require-dev": {
    "mb4it/bitrix-core-test": "@dev",
    "ext-pdo_sqlite": "*",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "F:\\Projects\\mb\\composer\\mb-bitrix-contracts"
    },
    {
      "type": "path",
      "url": "F:\\Projects\\mb\\composer\\mb-filesystem"
    },
    {
      "type": "path",
      "url": "F:\\Projects\\mb\\composer\\mb-bitrix-core-test"
    }
  ],
  "extra": {
    "bitrix-core-test": {
      "source": "local",
      "local_path": "F:/Projects/mb/engineering-experts.ru/bitrix",
      "version_policy": "warn"
    }
  },
  "authors": [
    {
      "name": "Maxim Bezvodinskikh",
      "email": "m.bezvodinskikh@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "MB\\Bitrix\\": "src/"
    },
    "files": [
      "src/Support/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "MB\\Bitrix\\Tests\\": "tests/"
    },
    "classmap": [
      "vendor/mb4it/bitrix-core-test/bitrix/modules/main/lib"
    ]
  },
  "scripts": {
    "lint": "@php scripts/dev/lint.php src tests scripts",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M",
    "test": "phpunit --testsuite default",
    "test:sqlite": "phpunit -c phpunit.sqlite.xml",
    "test:integration": "phpunit --bootstrap tests/integration-bootstrap.php --testsuite integration"
  }
}
